const http=require('node:http'),fs=require('node:fs'),path=require('node:path');const root=path.join(__dirname,'dist');http.createServer((req,res)=>{let p;try{p=path.resolve(root,'.'+decodeURIComponent(new URL(req.url,'http://localhost').pathname))}catch{res.writeHead(400);return res.end()}if(p!==root&&!p.startsWith(root+path.sep)){res.writeHead(403);return res.end()}if(p===root)p=path.join(root,'index.html');fs.readFile(p,(err,data)=>{if(err){res.writeHead(404);return res.end('Not found')}res.setHeader('Content-Type',({'.html':'text/html; charset=utf-8','.css':'text/css; charset=utf-8','.js':'text/javascript; charset=utf-8','.jpg':'image/jpeg'})[path.extname(p)]||'application/octet-stream');res.end(data)})}).listen(4318,'127.0.0.1',()=>console.log('Local: http://localhost:4318'));
